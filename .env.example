# Only local defaults. Never commit your private .env or tenant configuration.
FSA_MODE=local
FSA_CLOUD=AzureCloud
FSA_TENANT_ID=
FSA_SUBSCRIPTION_ID=
FSA_RESOURCE_GROUP=
FSA_ACCOUNT_NAME=
FSA_PROJECT_ENDPOINT=
FSA_MODEL_DEPLOYMENT=
FSA_AGENT_NAME=security-policy-agent
FSA_AGENT_VERSION=
FSA_SEARCH_ENDPOINT=
FSA_SEARCH_INDEX=
# Optional supplemental moderation; not Prompt Shields or a replacement for DLP.
FSA_CONTENT_SAFETY_ENDPOINT=
FSA_EXPORT_MONITOR=false
FSA_MONITOR_CONNECTION_STRING=
# Explicit optional OSS collector; cannot combine with Azure Monitor exporter.
FSA_OTLP_ENDPOINT=
FSA_LOGS_WORKSPACE_ID=
# Separate evaluation judge deployment and documented API version.
FSA_EVALUATION_ENDPOINT=
FSA_EVALUATION_DEPLOYMENT=
FSA_EVALUATION_API_VERSION=
FSA_EVALUATION_THRESHOLD=3
# Foundry and Agent365 cloud support must be verified independently.
