# mccp settings. Copy to .env in this folder (demos/mccp-multicloud-control-plane/.env). Never commit real values.
# Local mode needs none of these.
# Azure API Management AI gateway
APIM_GATEWAY_URL=https://<apim-name>.azure-api.net
APIM_RESOURCE_ID=/subscriptions/<sub-id>/resourceGroups/<rg>/providers/Microsoft.ApiManagement/service/<apim-name>
APIM_API_PATH=ai
APIM_SUBSCRIPTION_KEY=
APIM_ARM_API_VERSION=2024-05-01
# Microsoft Foundry
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/contoso-agents
FOUNDRY_MODEL_DEPLOYMENT=policy-model
FOUNDRY_OPENAI_API_VERSION=2025-04-01-preview
MCCP_REASONING_EFFORT=minimal
# Gateway identity provider (matches the Bicep identityProvider parameter): entra | okta
MCCP_IDENTITY_PROVIDER=entra
# infra/mccp/deploy.sh writes the live values to .env.mccp.azure (git-ignored, loaded automatically)
# Okta (agent identity)
OKTA_ORG_URL=https://<your-org>.okta.com
OKTA_ISSUER=https://<your-org>.okta.com/oauth2/<auth-server-id>
OKTA_AUDIENCE=api://contoso-ai-gateway
OKTA_API_TOKEN=
OKTA_CLIENT_ID=
OKTA_PRIVATE_KEY_PATH=./secrets/okta-agent-private-key.pem
OKTA_KEY_ID=
OKTA_SCOPES=ai.gateway.invoke
# ServiceNow (registry / AI Control Tower) — confirm table/API with the ServiceNow team
SERVICENOW_INSTANCE_URL=https://<instance>.service-now.com
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
SERVICENOW_TABLE=x_ai_agent_registry
# Observability
DD_API_KEY=
DD_SITE=datadoghq.com
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
APPLICATIONINSIGHTS_CONNECTION_STRING=
LOG_ANALYTICS_WORKSPACE_ID=
# AWS (optional extra)
AWS_REGION=us-east-1
# Local demo
MCCP_PRICE_TABLE=data/mccp/prices.json
MCCP_DEMO_DATE=2026-11-20
