    <mxCell id="1" parent="0"/>
    <mxCell id="title" value="Four function tools, one authorization boundary" style="text;html=1;fontSize=32;fontStyle=1;fontColor=#172B4D;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1320" height="50" as="geometry"/></mxCell>
    <mxCell id="subtitle" value="Python SDK client loop, not Agent Framework hosting | No Toolbox or server-side function executor" style="text;html=1;fontSize=22;fontColor=#334155;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="75" width="1320" height="40" as="geometry"/></mxCell>
    <mxCell id="client" value="CALLER PROCESS: fsa CLI / NOTEBOOK" style="swimlane;startSize=45;html=1;fontSize=24;fontStyle=1;fontColor=#0E7490;fillColor=#ECFEFF;swimlaneFillColor=#F8FAFC;strokeColor=#0E7490;strokeWidth=2;rounded=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="135" width="790" height="770" as="geometry"/></mxCell>
    <mxCell id="input" value="1. Explicit authorization + input screening&lt;br&gt;Trusted request; synthetic role; source ceiling" style="rounded=1;html=1;whiteSpace=wrap;fontSize=22;fontColor=#172B4D;fillColor=#FFFFFF;strokeColor=#0E7490;strokeWidth=2;" vertex="1" parent="client"><mxGeometry x="35" y="65" width="720" height="80" as="geometry"/></mxCell>
    <mxCell id="loop" value="2. Verify pinned agent; request a response&lt;br&gt;At most 3 model calls / 6 proposed tool calls&lt;br&gt;Serial only; no retries; final round has no tools" style="rounded=1;html=1;whiteSpace=wrap;fontSize=22;fontColor=#172B4D;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;" vertex="1" parent="client"><mxGeometry x="35" y="180" width="720" height="105" as="geometry"/></mxCell>
    <mxCell id="authorize" value="3. AUTHORIZE BEFORE EVERY HANDLER&lt;br&gt;Strict schema; allowlist; call-ID replay check&lt;br&gt;Role/source trimming; quarantine and taint checks" style="rounded=1;html=1;whiteSpace=wrap;fontSize=22;fontStyle=1;fontColor=#713F12;fillColor=#FFFBEB;strokeColor=#A16207;strokeWidth=2;" vertex="1" parent="client"><mxGeometry x="35" y="325" width="720" height="105" as="geometry"/></mxCell>
    <mxCell id="reads" value="4a. Read-only handlers&lt;br&gt;search_policies&lt;br&gt;get_policy_section&lt;br&gt;get_ticket_status" style="rounded=1;html=1;whiteSpace=wrap;fontSize=22;fontColor=#172B4D;fillColor=#ECFEFF;strokeColor=#0E7490;strokeWidth=2;" vertex="1" parent="client"><mxGeometry x="35" y="475" width="340" height="140" as="geometry"/></mxCell>
    <mxCell id="queue" value="4b. create_records_request&lt;br&gt;Exact original user intent&lt;br&gt;Signed local proposal&lt;br&gt;Not a business write" style="rounded=1;html=1;whiteSpace=wrap;fontSize=22;fontColor=#14532D;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=2;" vertex="1" parent="client"><mxGeometry x="415" y="475" width="340" height="140" as="geometry"/></mxCell>
    <mxCell id="output" value="5. Safe continuation + output checks&lt;br&gt;Approved-source citations or abstention; moderation" style="rounded=1;html=1;whiteSpace=wrap;fontSize=22;fontColor=#172B4D;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;" vertex="1" parent="client"><mxGeometry x="35" y="655" width="720" height="85" as="geometry"/></mxCell>
    <mxCell id="agent" value="Microsoft Foundry prompt agent&lt;br&gt;Reviewed instructions + model&lt;br&gt;Four registered function schemas&lt;br&gt;Model proposes; client dispatches" style="rounded=1;html=1;whiteSpace=wrap;fontSize=22;fontColor=#172B4D;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="930" y="175" width="430" height="155" as="geometry"/></mxCell>
    <mxCell id="search" value="Synthetic Azure AI Search&lt;br&gt;Classification filter before ranking&lt;br&gt;Content pinned to corpus manifest&lt;br&gt;Retrieved text is always untrusted" style="rounded=1;html=1;whiteSpace=wrap;fontSize=22;fontColor=#172B4D;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="930" y="420" width="430" height="155" as="geometry"/></mxCell>
    <mxCell id="approval" value="Independent synthetic reviewer&lt;br&gt;Exact hash; 15-minute expiry&lt;br&gt;No self-approval; no replay&lt;br&gt;DRY_RUN receipt only" style="rounded=1;html=1;whiteSpace=wrap;fontSize=22;fontColor=#14532D;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="930" y="675" width="430" height="155" as="geometry"/></mxCell>
    <mxCell id="evidence" value="Audit + OpenTelemetry + independent verification&lt;br&gt;Local hash-linked audit and correlated spans; optional approved Monitor export&lt;br&gt;Native Agent 365 / Defender / Purview evidence is a separate pipeline" style="rounded=1;html=1;whiteSpace=wrap;fontSize=22;fontColor=#4C1D95;fillColor=#FAF5FF;strokeColor=#7E22CE;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="940" width="1320" height="95" as="geometry"/></mxCell>
