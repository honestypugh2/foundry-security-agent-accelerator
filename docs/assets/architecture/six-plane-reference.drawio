<mxGraphModel dx="1600" dy="1080" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="1080" background="#FFFFFF" adaptiveColors="none">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="title" value="Foundry + Agent 365: one flow, six planes" style="text;html=1;fontSize=42;fontStyle=1;fontColor=#172B4D;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="1500" height="65" as="geometry"/></mxCell>
    <mxCell id="subtitle" value="One AI workflow. Six surrounding control planes. Independent enforcement and evidence." style="text;html=1;fontSize=24;fontColor=#334155;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="50" y="105" width="1500" height="45" as="geometry"/></mxCell>
    <mxCell id="tags" value="ACCESS     /     DO     /     HAPPENED     /     INTERVENE" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#0369A1;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="50" y="165" width="1500" height="35" as="geometry"/></mxCell>
    <mxCell id="azure" value="AZURE SERVICES - not the caller process" style="swimlane;startSize=35;html=1;fontSize=20;fontStyle=1;fontColor=#1E40AF;fillColor=#EFF6FF;swimlaneFillColor=#F8FAFC;strokeColor=#2563EB;strokeWidth=2;dashed=1;rounded=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="530" y="530" width="540" height="255" as="geometry"/></mxCell>
    <object id="user" kind="flow" step="1" phase="ACCESS" label="&lt;b&gt;1. User&lt;/b&gt;&lt;br&gt;Synthetic workshop question" tooltip="A user starts a synthetic question. Animation illustrates responsibilities, not observed Azure activity or a protocol packet sequence.">
      <mxCell style="rounded=1;html=1;whiteSpace=wrap;fontSize=23;fontColor=#172B4D;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=2;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="550" y="220" width="500" height="70" as="geometry"/></mxCell>
    </object>
    <object id="interface" kind="flow" step="3" phase="DO" label="&lt;b&gt;3. Application / agent interface&lt;/b&gt;&lt;br&gt;fsa CLI and opt-in notebooks" tooltip="The fsa CLI and explicitly opted-in notebooks select Azure or local mode. A service failure never silently becomes a local success.">
      <mxCell style="rounded=1;html=1;whiteSpace=wrap;fontSize=23;fontColor=#172B4D;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="550" y="320" width="500" height="70" as="geometry"/></mxCell>
    </object>
    <object id="runtime" kind="flow" step="4" phase="DO" label="&lt;b&gt;4. Governed Python runtime&lt;/b&gt;&lt;br&gt;Authorize before every handler&lt;br&gt;Caller-side SDK loop" tooltip="presentation_live.py runs a bounded serial function loop in the caller, not an Agent Framework host. Every proposed handler needs typed arguments and fresh policy authorization before execution.">
      <mxCell style="rounded=1;html=1;whiteSpace=wrap;fontSize=23;fontColor=#172B4D;fillColor=#ECFEFF;strokeColor=#0E7490;strokeWidth=2;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="550" y="420" width="500" height="90" as="geometry"/></mxCell>
    </object>
    <object id="project" kind="flow" step="5" phase="DO" label="&lt;b&gt;5. Microsoft Foundry project&lt;/b&gt;&lt;br&gt;Reviewed, pinned prompt agent" tooltip="The client checks the immutable agent definition, model and four function schemas before inference. Direct function schemas do not require a Toolbox; the playground does not execute this application's Python handlers.">
      <mxCell style="rounded=1;html=1;whiteSpace=wrap;fontSize=23;fontColor=#172B4D;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="550" y="575" width="500" height="75" as="geometry"/></mxCell>
    </object>
    <object id="services" kind="flow" step="6" phase="DO" label="&lt;b&gt;6. Model + retrieval + schemas&lt;/b&gt;&lt;br&gt;Azure model and synthetic Search&lt;br&gt;Function execution stays in client" tooltip="The model proposes a function call; the application authorizes and executes it. Search uses the approved content-pinned synthetic corpus and server-side filtering. Ordinary Search is not proof of Foundry IQ.">
      <mxCell style="rounded=1;html=1;whiteSpace=wrap;fontSize=23;fontColor=#172B4D;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="550" y="680" width="500" height="90" as="geometry"/></mxCell>
    </object>
    <object id="actions" kind="flow" step="7" phase="DO" label="&lt;b&gt;7. Governed data and actions&lt;/b&gt;&lt;br&gt;Synthetic data; local approval queue&lt;br&gt;Exact independent approval; DRY_RUN" tooltip="Client policy gates the proposal before queueing. Approval is exact, independent, expiring and one-use. Synthetic role labels are not Entra OBO or enterprise human approval. The supplied writer records only local DRY_RUN receipts, never real business writes.">
      <mxCell style="rounded=1;html=1;whiteSpace=wrap;fontSize=23;fontColor=#14532D;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=2;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="550" y="825" width="500" height="100" as="geometry"/></mxCell>
    </object>
    <object id="entra" kind="plane" step="2" phase="ACCESS" label="ACCESS / IDENTITY&lt;br&gt;&lt;b&gt;2. Microsoft Entra&lt;/b&gt;&lt;br&gt;Agent authentication&lt;br&gt;Least-privilege resource access&lt;br&gt;Lab role labels are not OBO" tooltip="identity.py binds SDK authentication to the configured tenant. Effective resource permissions, Conditional Access and production agent identity require independent tenant evidence; synthetic workshop roles do not authenticate a user.">
      <mxCell style="rounded=1;html=1;whiteSpace=wrap;fontSize=23;fontColor=#172B4D;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;align=left;spacing=20;" vertex="1" parent="1"><mxGeometry x="50" y="240" width="390" height="185" as="geometry"/></mxCell>
    </object>
    <object id="agent365" kind="plane" phase="INTERVENE" label="INTERVENE / GOVERNANCE&lt;br&gt;&lt;b&gt;Microsoft Agent 365&lt;/b&gt;&lt;br&gt;Registry; owners and sponsors&lt;br&gt;Lifecycle; native activity&lt;br&gt;Verify independently" tooltip="Agent 365 provides a native registry and governance surface, subject to supported tenant, licensing, publication and consent. Repository settings, local lifecycle simulation or inventory screenshots do not prove native activity or a working lifecycle control.">
      <mxCell style="rounded=1;html=1;whiteSpace=wrap;fontSize=23;fontColor=#4C1D95;fillColor=#FAF5FF;strokeColor=#7E22CE;strokeWidth=2;dashed=1;align=left;spacing=20;" vertex="1" parent="1"><mxGeometry x="50" y="490" width="390" height="185" as="geometry"/></mxCell>
    </object>
    <object id="purview" kind="plane" phase="ACCESS / HAPPENED" label="ACCESS + HAPPENED / DATA&lt;br&gt;&lt;b&gt;Microsoft Purview&lt;/b&gt;&lt;br&gt;DSPM; DLP; audit; labels&lt;br&gt;eDiscovery and compliance&lt;br&gt;Native policies are separate" tooltip="Purview data protection and audit require independent native policy, connector, consent, permissions and event evidence. Application classifications and hash-linked local audit records are not Purview enforcement or ingestion proof.">
      <mxCell style="rounded=1;html=1;whiteSpace=wrap;fontSize=23;fontColor=#4C1D95;fillColor=#FAF5FF;strokeColor=#7E22CE;strokeWidth=2;dashed=1;align=left;spacing=20;" vertex="1" parent="1"><mxGeometry x="50" y="740" width="390" height="185" as="geometry"/></mxCell>
    </object>
    <object id="defender" kind="plane" step="9" phase="HAPPENED / INTERVENE" label="HAPPENED + INTERVENE / THREATS&lt;br&gt;&lt;b&gt;9. Microsoft Defender&lt;/b&gt;&lt;br&gt;AI posture; protection; inventory&lt;br&gt;XDR investigation and incidents&lt;br&gt;Verify native signals separately" tooltip="Inventory, posture, activity and threat findings are distinct Defender observations. An inventory entry does not prove runtime ingestion, detection or protection. Observe only existing authorized evidence; this animation triggers no alerts or investigation.">
      <mxCell style="rounded=1;html=1;whiteSpace=wrap;fontSize=23;fontColor=#4C1D95;fillColor=#FAF5FF;strokeColor=#7E22CE;strokeWidth=2;dashed=1;align=left;spacing=20;" vertex="1" parent="1"><mxGeometry x="1160" y="240" width="390" height="185" as="geometry"/></mxCell>
    </object>
    <object id="monitor" kind="plane" step="8" phase="HAPPENED" label="HAPPENED / OBSERVABILITY&lt;br&gt;&lt;b&gt;8. Azure Monitor / App Insights&lt;/b&gt;&lt;br&gt;OpenTelemetry; correlation&lt;br&gt;Traces and diagnostics&lt;br&gt;Export is not ingestion proof" tooltip="observability.py records correlated application spans and supports explicitly approved export and read-only Logs queries. A sent span is not confirmed ingestion, and application telemetry is not native Agent 365 activity.">
      <mxCell style="rounded=1;html=1;whiteSpace=wrap;fontSize=23;fontColor=#172B4D;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;align=left;spacing=20;" vertex="1" parent="1"><mxGeometry x="1160" y="490" width="390" height="185" as="geometry"/></mxCell>
    </object>
    <object id="github" kind="plane" phase="DO" label="DO / RELEASE ASSURANCE&lt;br&gt;&lt;b&gt;GitHub / CI/CD&lt;/b&gt;&lt;br&gt;Tests; evaluation release gates&lt;br&gt;Source scans; offline labs&lt;br&gt;No automatic cloud deployment" tooltip="GitHub Actions runs deterministic tests, evaluation gates and source-pattern scans without Azure credentials or automatic deployment. Security failures and insufficient evidence block release even if a quality judge passes. Scans are not a complete confidentiality or penetration-test assessment.">
      <mxCell style="rounded=1;html=1;whiteSpace=wrap;fontSize=23;fontColor=#713F12;fillColor=#FFFBEB;strokeColor=#A16207;strokeWidth=2;align=left;spacing=20;" vertex="1" parent="1"><mxGeometry x="1160" y="740" width="390" height="185" as="geometry"/></mxCell>
    </object>
    <mxCell id="u-i" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#0369A1;strokeWidth=3;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="user" target="interface"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="i-r" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#0369A1;strokeWidth=3;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="interface" target="runtime"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="r-p" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#0369A1;strokeWidth=3;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="runtime" target="project"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="p-s" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#0369A1;strokeWidth=3;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="project" target="services"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e-r" style="curved=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="entra" target="runtime"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="r-a" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#15803D;strokeWidth=3;endArrow=block;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="runtime" target="actions"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="495" y="465"/><mxPoint x="495" y="875"/></Array></mxGeometry></mxCell>
    <mxCell id="a365-p" style="curved=1;strokeColor=#7E22CE;strokeWidth=2;dashed=1;endArrow=open;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="agent365" target="project"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="pv-a" style="curved=1;strokeColor=#7E22CE;strokeWidth=2;dashed=1;endArrow=open;exitX=1;exitY=0.5;entryX=0;entryY=0.8;" edge="1" parent="1" source="purview" target="actions"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="p-d" style="curved=1;strokeColor=#7E22CE;strokeWidth=2;dashed=1;endArrow=open;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="project" target="defender"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="r-m" style="curved=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="runtime" target="monitor"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="gh-a" style="curved=1;strokeColor=#A16207;strokeWidth=2;dashed=1;endArrow=open;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="github" target="actions"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="legend" value="Solid: application/service path | Purple dashed: native relationship, verify separately | Gold dashed: CI, not deployment" style="text;html=1;fontSize=20;fontColor=#334155;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="50" y="970" width="1500" height="35" as="geometry"/></mxCell>
    <mxCell id="boundary" value="Conceptual flow, not packet order. Handlers and approvals stay in caller. Synthetic roles are not Entra OBO. All writes: DRY_RUN." style="text;html=1;fontSize=20;fontColor=#334155;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="50" y="1015" width="1500" height="35" as="geometry"/></mxCell>
  </root>
</mxGraphModel>
